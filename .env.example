# Required in production
SESSION_SECRET=long-random-string
PUBLIC_URL=https://app.yourdomain.com

# Claude (the brain). Without it, sessions run in scripted preview mode.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Tavus (photoreal video). Without it, sessions run in voice mode.
TAVUS_API_KEY=
TAVUS_DEFAULT_FACE_ID=
TAVUS_WEBHOOK_TOKEN=long-random-string

# Optional
DATA_DIR=./.data
LEADS_WEBHOOK_URL=

# Real faces: pin each look to a Tavus face (optional; stock faces are auto-assigned)
TAVUS_FACES=
# Password-reset email (Resend). Without it, reset links are logged to the server console.
RESEND_API_KEY=
EMAIL_FROM="ManavOS <hello@manavos.ai>"
# Billing (Stripe). Without these, upgrade buttons point to /pricing.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BUILDER=
STRIPE_PRICE_GROWTH=
